# ------------------------------------------------------------------
# .env.example (grouped with comments) — generated 2025-09-03 05:27:32
# NOTE: Values are sample defaults. Copy to .env and adjust for env.
# ------------------------------------------------------------------

# Flask & App Configuration

# Random secret for Flask sessions/CSRF (set a strong unique string in prod).
FLASK_SECRET_KEY='change-me'

# Version string to bust caches on deploys (e.g., v1.0.15).
ASSETS_VERSION=v1.0.20

# HTTP cache max-age (seconds) for static assets.
STATIC_MAX_AGE=5

# Number of server workers/threads (depends on deployment).
WORKERS=4

# Default timezone for display
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata


# Database Configuration

# SQLAlchemy DSN (sqlite:///file.db or postgresql+psycopg2://user:pass@host:5432/db).
DATABASE_URL=sqlite:///image_manager.db


# Directory Configuration

# Upload directories for ZIP processing
UPLOAD_DIR=files/zip_upload_zips
IMAGE_DIR=files/zip_upload_images
PDF_DIR=files/zip_upload_pdfs
PROCESSED_DIR=files/zips_upload_processed
PROCESSING_ERROR_DIR=files/zip_upload_processing_error

# Directories for disease-specific PDFs
DR_PDF_DIR=files/dr_pdfs
GLAUCOMA_PDF_DIR=files/glaucoma_pdfs

# Directory for direct image uploads
DIRECT_UPLOAD_DIR=files/direct_uploads

# Logging directory
LOG_DIR=logs


# Upload Limits & Validation

# Max total request size (bytes). Keep reverse proxy limits in sync.
MAX_CONTENT_LENGTH=224288000

# Max size in bytes for a single uploaded file.
PER_FILE_MAX_BYTES=10485760

# Max number of files allowed per upload request.
MAX_FILES_PER_UPLOAD=50


# Direct Uploads Configuration

# Cap on number of images allowed per direct upload batch.
DIRECT_UPLOAD_MAX_FILES=100

# Per-file size cap (MB) for direct uploads.
DIRECT_UPLOAD_MAX_FILE_SIZE_MB=5

# Comma-separated list of allowed MIME types for direct uploads.
DIRECT_UPLOAD_ALLOWED_MIMETYPES="image/jpeg,image/png"


# Session & Security Configuration

# Session cookie settings
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=True

# Inactivity timeout (minutes) for automatic logout
INACTIVITY_TIMEOUT_MINUTES=30

# Security pepper for password hashing (optional but recommended)
AUTH_PEPPER=

# CSRF protection time limit (seconds)
WTF_CSRF_TIME_LIMIT=3600


# Email Configuration (for notifications)

# SMTP server settings
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=xxxx
SMTP_PASSWORD=yyyyy
FROM_EMAIL=

# Email SSL/TLS settings
SMTP_USE_SSL=false

# Enable debug logging for emails
EMAIL_DEBUG_LOGGING=false


# Logging Configuration

# Path to various log files
HTTP_SUCCESS_LOG=logs/http_success.log
HTTP_ERROR_LOG=logs/http_error.log
ZIP_INGEST_LOG=logs/zip_main_process_log.txt
SUCCESS_LOG=logs/process_pdf_success_log.txt
ERROR_LOG=logs/process_pdf_error_log.txt
MALICIOUS_UPLOAD_LOG=logs/malicious_uploads.log

# Log viewer configuration
LOG_VIEWER_ROOT=logs
LOG_VIEWER_MAX_BYTES=500000


# Pagination & UI Configuration

# Default page size for various listings
UPLOADED_RESULTS_PAGE_SIZE=25
SCREENINGS_PAGE_SIZE=50
ANALYTICS_SEARCH_IMAGES_PAGE_SIZE=50


# Grading & Arbitration Configuration

# Hours within  which arbitrator can revise grades
ARBITRATOR_REVISION_HOURS=6
