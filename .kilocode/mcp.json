{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.38",
        "--browser=",
        "--headless=",
        "--viewport-size="
      ],
      "disabled": false,
      "alwaysAllow": []
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@chrome-devtools-mcp@latest"
      ],
      "disabled": false,
      "alwaysAllow": []
    }
  }
}