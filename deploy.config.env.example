# Non-sensitive configuration for Fundus Image Manager containers.
# Copy to deploy.config.env and adjust values as needed.

# Flask application
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
BASE_URL=http://127.0.0.1:5001
ENABLE_DEBUG_LOGGING=false
ASSETS_VERSION=v1.0.35
# STATIC_MAX_AGE=5  # Development: 5 seconds
# STATIC_MAX_AGE=3600  # Production: 1 hour
STATIC_MAX_AGE=604800  # Production: 1 week
WORKERS=4
DEBUG=false


# Gunicorn
GUNICORN_BIND=0.0.0.0:5001
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info
GUNICORN_ACCESS_LOG=/var/log/fundus-img-xtract/gunicorn_access.log
GUNICORN_ERROR_LOG=/var/log/fundus-img-xtract/gunicorn_error.log
GUNICORN_PID_FILE=/var/run/fundus-img-xtract/gunicorn.pid

# Upload directories (bind-mounted)
UPLOAD_DIR=files/zip_upload_zips
IMAGE_DIR=files/zip_upload_images
PDF_DIR=files/zip_upload_pdfs
PROCESSED_DIR=files/zips_upload_processed
PROCESSING_ERROR_DIR=files/zip_upload_processing_error
DR_PDF_DIR=files/dr_pdfs
GLAUCOMA_PDF_DIR=files/glaucoma_pdfs
DIRECT_UPLOAD_DIR=files/direct_uploads

# Upload limits
MAX_CONTENT_LENGTH=224288000
PER_FILE_MAX_BYTES=10485760
MAX_FILES_PER_UPLOAD=100
DIRECT_UPLOAD_MAX_FILES=100
DIRECT_UPLOAD_MAX_FILE_SIZE_MB=10
DIRECT_UPLOAD_ALLOWED_MIMETYPES="image/jpeg,image/png"

# Logging
LOG_DIR=/app/logs
#LOG_DIR=/var/log/fundus-img-xtract
HTTP_SUCCESS_LOG=logs/http_success.log
HTTP_ERROR_LOG=logs/http_error.log
ZIP_INGEST_LOG=logs/zip_main_process_log.txt
SUCCESS_LOG=logs/process_pdf_success_log.txt
ERROR_LOG=logs/process_pdf_error_log.txt
MALICIOUS_UPLOAD_LOG=logs/malicious_uploads.log
LOG_VIEWER_ROOT=logs
LOG_VIEWER_MAX_BYTES=500000

# Stats logger
STATS_INTERVAL=30
TARGET_CONTAINERS=fundus-img-xtract-web fundus-img-xtract-db fundus-img-xtract-cache
DOCKER_GID=988




# Pagination & UI
UPLOADED_RESULTS_PAGE_SIZE=25
SCREENINGS_PAGE_SIZE=50
DEFAULT_DISPLAY_TIMEZONE=Asia/Kolkata
ANALYTICS_SEARCH_IMAGES_PAGE_SIZE=50

# Session & security
# Session & security
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true #  true if SSL configured
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_PATH=/
SESSION_COOKIE_NAME=session
WTF_CSRF_TIME_LIMIT=3600
INACTIVITY_TIMEOUT_MINUTES=30
INACTIVITY_WARNING_LEAD_MINUTES=10
SESSION_COOKIE_DOMAIN=
PREFERRED_URL_SCHEME=https


# Proxy configuration
TRUST_PROXY_HOPS=1
FORCE_HTTPS=true

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT="500 per hour, 60 per minute"
RATELIMIT_APPLICATION="1000 per hour, 120 per minute"
RATELIMIT_STRATEGY=fixed-window
RATELIMIT_HEADERS_ENABLED=true
RATELIMIT_HEADER_LIMIT=X-RateLimit-Limit
RATELIMIT_HEADER_REMAINING=X-RateLimit-Remaining
RATELIMIT_HEADER_RESET=X-RateLimit-Reset
RATELIMIT_SWALLOW_ERRORS=true
RATELIMIT_FAIL_ON_FIRST_BREACH=false
RATELIMIT_DEDUPLICATE=false

# Email (non-secret portions)
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USE_SSL=false
EMAIL_DEBUG_LOGGING=false
FROM_EMAIL=

# Application features
ARBITRATOR_REVISION_HOURS=6


# Materialized View Refresh Scheduler
MATERIALIZED_VIEW_SCHEDULE_ENABLED=true
MATERIALIZED_VIEW_SCHEDULE_TIMES=07:00,13:30,19:00,01:30
MATERIALIZED_VIEW_TIMEZONE=Asia/Kolkata
MATERIALIZED_VIEW_RETRY_ATTEMPTS=3
MATERIALIZED_VIEW_RETRY_DELAY_SECONDS=60

# Thumbnail Maintenance Scheduler
THUMBNAIL_MAINTENANCE_ENABLED=true
THUMBNAIL_MAINTENANCE_TIMEZONE=Asia/Kolkata
THUMBNAIL_MAINTENANCE_SCHEDULE_TIMES=02:30,07:00,13:30,19:00,01:30
THUMBNAIL_MAINTENANCE_CLEANUP_LIMIT=1000
THUMBNAIL_MAINTENANCE_REGENERATION_LIMIT=100
THUMBNAIL_MAINTENANCE_VALIDATION_SAMPLE_SIZE=200
THUMBNAIL_MAINTENANCE_LOG_LEVEL=INFO
