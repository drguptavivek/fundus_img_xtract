# Sensitive secrets for Fundus Image Manager containers.
# Copy to deploy.secrets.env, fill in strong values, and keep it out of version control.

# Flask
FLASK_SECRET_KEY=replace-with-64-char-secret

# PostgreSQL
POSTGRES_APP_DB=fundus_app
POSTGRES_APP_USER=fundus_user
POSTGRES_APP_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-this-redis-password

# Optional email credentials
SMTP_USERNAME=
SMTP_PASSWORD=
