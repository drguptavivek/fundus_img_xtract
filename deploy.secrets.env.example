# Copy to deploy.secrets.env, fill in strong values, and keep it out of version control.

# Flask
FLASK_SECRET_KEY=replace-with-64-char-secret
JWT_SECRET=replace-with-64-char-mobile-jwt-secret

# PostgreSQL
POSTGRES_APP_DB=fundus_app
POSTGRES_APP_USER=fundus_user
POSTGRES_APP_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-this-redis-password
REDIS_HOST=cache
#REDIS_HOST_LOCAL=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# S3 Multi-Tenant Storage - Master Encryption Key (PyNaCl)
# 32-byte base64-encoded key used to derive hospital-specific encryption keys.
# Generate: `python - <<'PY'\nimport base64, os\nprint(base64.b64encode(os.urandom(32)).decode())\nPY`
S3_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Docker compose interpolation (non-secret but required at parse time)
FLASK_PORT=5001
CELERY_LOG_LEVEL=info
CELERY_OCR_CONCURRENCY=1
CELERY_GENERAL_CONCURRENCY=2
TARGET_CONTAINERS=fundus-img-xtract-web fundus-img-xtract-db fundus-img-xtract-cache fundus-img-xtract-celery-ocr fundus-img-xtract-celery-general fundus-img-xtract-celery-beat
STATS_INTERVAL=30
DOCKER_GID=988
