services:
  web:
    env_file:
      - deploy.config.env
      - deploy.secrets.env
      - develop.config.env
    command:
      - uv
      - run
      - flask
      - --app
      - app.py
      - run
      - --host
      - "${FLASK_HOST:-0.0.0.0}"
      - --port
      - "${FLASK_PORT:-5001}"
      - --reload
    environment:
      FLASK_ENV: development
      FLASK_DEBUG: "1"
    volumes:
      - .:/app
      - ./files:/app/files
      - ./logs:/app/logs
      - web_venv:/app/.venv

volumes:
  web_venv:
