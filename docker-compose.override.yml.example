services:
  beat-venv-builder:
    volumes:
      - .:/app
      - beat_venv:/app/.venv

  ocr-venv-builder:
    volumes:
      - .:/app
      - ocr_venv:/app/.venv

  web-venv-builder:
    volumes:
      - .:/app
      - web_venv:/app/.venv

  general-venv-builder:
    volumes:
      - .:/app
      - general_venv:/app/.venv

  web:
    env_file:
      - deploy.config.env
      - deploy.secrets.env
      - develop.config.env
    command:
      - sh
      - -c
      - >
        uv run python -m watchfiles
        --filter utils.watchfiles_filter.py_html_filter
        --target-type command
        "flask --app app.py run --host 0.0.0.0 --port 5001 --no-reload"
        /app
    environment:
      FLASK_ENV: development
      FLASK_DEBUG: "1"
    volumes:
      - .:/app
      - ./files:/app/files
      - ./logs:/app/logs
      - web_venv:/app/.venv

  celery-ocr-worker:
    volumes:
      - .:/app
      - ./files:/app/files
      - ./logs:/app/logs
      - ocr_venv:/app/.venv
    command:
      - uv
      - run
      - celery
      - -A
      - celery_worker
      - worker
      - --loglevel=info
      - --concurrency=1
      - -Q
      - zip_ocr,pii_detection,pdf_processing
      - --pool=solo
    environment:
      CELERY_TASKS_PROFILE: "ocr"

  celery-general-worker:
    volumes:
      - .:/app
      - ./files:/app/files
      - ./logs:/app/logs
      - general_venv:/app/.venv
    command:
      - uv
      - run
      - celery
      - -A
      - celery_worker
      - worker
      - --loglevel=info
      - --concurrency=2
      - -Q
      - thumbnails,metadata,exports,maintenance,s3_sync,default
      - --pool=solo
    environment:
      CELERY_TASKS_PROFILE: "general"

  celery-beat:
    volumes:
      - .:/app
      - ./files:/app/files
      - ./logs:/app/logs
      - beat_venv:/app/.venv
    environment:
      CELERY_TASKS_PROFILE: "maintenance"

volumes:
  web_venv:
  beat_venv:
  general_venv:
  ocr_venv:
