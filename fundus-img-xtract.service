[Unit]
Description=Fundus Image Manager - Gunicorn instance
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/path/to/fundus_img_xtract
Environment=PATH=/path/to/fundus_img_xtract/.venv/bin
EnvironmentFile=/path/to/fundus_img_xtract/.env
ExecStart=/path/to/fundus_img_xtract/.venv/bin/gunicorn -c gunicorn_config.py wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=append:/var/log/fundus-img-xtract/access.log
StandardError=append:/var/log/fundus-img-xtract/error.log

[Install]
WantedBy=multi-user.target