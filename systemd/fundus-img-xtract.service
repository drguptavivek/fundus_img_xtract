[Unit]
Description=Fundus Image Manager - Gunicorn instance
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/fundus_img_xtract
Environment="PATH=/opt/fundus_img_xtract/.venv/bin:$PATH"
EnvironmentFile=-/opt/fundus_img_xtract/.env
ExecStartPre=/usr/bin/install -d -o www-data -g www-data -m 0750 /var/log/fundus-img-xtract
ExecStartPre=/usr/bin/install -d -o www-data -g www-data -m 0750 /var/run/fundus-img-xtract
ExecStart=/opt/fundus_img_xtract/.venv/bin/uv run gunicorn -c gunicorn_config.py wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=append:/var/log/fundus-img-xtract/systemd_access.log
StandardError=append:/var/log/fundus-img-xtract/systemd_error.log

[Install]
WantedBy=multi-user.target
