{% extends "base.html" %}\n{% block title %}Grading{% endblock %}\n\n{% block content %}\n{% from "_forms.html" import csrf_field %}\n\n{% macro badge_for_for(val) %}\n  {% set v = (val or '')|lower %}\n  {% if v == 'glaucoma' %}\n    <span class="badge rounded-pill badge-soft-primary">Glaucoma</span>\n  {% elif v == 'dr' %}\n    <span class="badge rounded-pill badge-soft-info">DR</span>\n  {% elif v == 'amd' %}\n    <span class="badge rounded-pill badge-soft-purple">AMD</span>\n  {% else %}\n    <span class="badge rounded-pill badge-soft-secondary">{{ val or '-' }}</span>\n  {% endif %}\n{% endmacro %}\n\n{% macro badge_for_impression(val) %}\n  {% set t = (val or '') %}\n  {% if t|lower == 'normal' %}\n    <span class="badge rounded-pill badge-soft-success">Normal</span>\n  {% elif t|lower in ['glaucoma suspect','suspect'] %}\n    <span class="badge rounded-pill badge-soft-warning">Glaucoma Suspect</span>\n  {% elif t|lower == 'glaucoma' %}\n    <span class="badge rounded-pill badge-soft-danger">Glaucoma</span>\n  {% elif t|lower in ['other retinal','other'] %}\n    <span class="badge rounded-pill badge-soft-info">Other Retinal</span>\n  {% elif t|lower in ['not gradable','notgradable','ungradable'] %}\n    <span class="badge rounded-pill badge-soft-secondary">Not gradable</span>\n  {% else %}\n    <span class="badge rounded-pill badge-soft-secondary">{{ val or '-' }}</span>\n  {% endif %}\n{% endmacro %}\n\n\n<div class="d-flex justify-content-between align-items-center mb-3">\n  <h3 class="mb-0">Image Grading</h3>\n  <div class="d-flex gap-2">\n    {% if current_user_has('admin') or current_user_has('ophthalmologist') %}\n    <!-- Arbitration dashboard link removed as the route no longer exists -->\n    {% endif %}\n  </div>\n</div>\n\n<!-- Dual Grading Tasks in Three Columns -->\n<div class="row">\n  <!-- Resident Tasks Column -->\n  <div class="col-md-6">\n    <div class="card shadow-sm mb-4 h-100">\n      <div class="card-header">\n        <strong>Resident Tasks</strong>\n      </div>\n      <div class="card-body">\n        {% if resident_tasks %}\n          {% for disease_name, tasks in resident_tasks.items() %}\n            {% if tasks %}\n            <div class="card mb-3">\n              <div class="card-header d-flex justify-content-between align-items-center">\n                <strong>{{ disease_name }}</strong>\n                <span class="badge bg-primary">{{ resident_totals[disease_name] }} pending</span>\n              </div>\n              <div class="card-body p-2">\n                <div class="list-group list-group-flush">\n                  {% for task in tasks %}\n                    <a href="{{ url_for('grading.dual_grading_task', task_id=task.id) }}" class="list-group-item list-group-item-action">\n                      <div class="d-flex justify-content-between align-items-center">\n                        <span class="me-2">Task #{{ task.id }}</span>\n                        <span class="badge bg-info">{{ task.state }}</span>\n                      </div>\n                      <div class="d-flex align-items-center mt-1">\n                        {% if task.encounter_file %}\n                          <div class="me-2">\n                            <img src="{{ url_for('media._imgForGradingByUUID', uuid_str=task.encounter_file.uuid) }}" alt="Thumbnail" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">\n                          </div>\n                          <div>\n                            <small class="text-muted">\n                              Image: {{ task.encounter_file.uuid }}\n                            </small>\n                            <div>\n                              <small class="text-muted">Hospital: {{ task.lab_unit.name if task.lab_unit else 'Unknown' }}</small>\n                            </div>\n                            <div>\n                              <small class="text-muted">\n                                Capture Date: \n                                {% if task.encounter_file.patient_encounter and task.encounter_file.patient_encounter.capture_date_dt %}\n                                  {{ task.encounter_file.patient_encounter.capture_date_dt.strftime('%Y-%m-%d') }}\n                                {% else %}\n                                  Unknown\n                                {% endif %}\n                              </small>\n                            </div>\n                          </div>\n                        {% elif task.direct_image %}\n                          <div class="me-2">\n                            <img src="{{ url_for('media._imgForGradingByUUID', uuid_str=task.direct_image.uuid) }}" alt="Thumbnail" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">\n                          </div>\n                          <div>\n                            <small class="text-muted">\n                              Image: {{ task.direct_image.uuid }}\n                            </small>\n                            <div>\n                              <small class="text-muted">Hospital: {{ task.direct_image.lab_unit.name if task.direct_image.lab_unit else 'Unknown' }}</small>\n                            </div>\n                            <div>\n                              <small class="text-muted">\n                                Upload Date: \n                                {% if task.direct_image.created_at %}\n                                  {{ task.direct_image.created_at.strftime('%Y-%m-%d') }}\n                                {% else %}\n                                  Unknown\n                                {% endif %}\n                              </small>\n                            </div>\n                          </div>\n                        {% endif %}\n                      </div>\n                    </a>\n                  {% endfor %}\n                </div>\n              </div>\n              {% if resident_total_pages[disease_name] > 1 %}\n              <div class="card-footer d-flex justify-content-between">\n                <a href="{{ resident_prev_urls[disease_name] or '#' }}" class="btn btn-sm btn-outline-secondary {% if not resident_prev_urls[disease_name] %}disabled{% endif %}">Prev</a>\n                <span class="small text-muted">Page {{ request.args.get('resident_' + disease_name.replace(' ', '_') + '_p', 1) }} of {{ resident_total_pages[disease_name] }}</span>\n                <a href="{{ resident_next_urls[disease_name] or '#' }}" class="btn btn-sm btn-outline-secondary {% if not resident_next_urls[disease_name] %}disabled{% endif %}">Next</a>\n              </div>\n              {% endif %}\n            </div>\n            {% endif %}\n          {% endfor %}\n        {% else %}\n          <p class="text-muted">No resident tasks available.</p>\n        {% endif %}\n      </div>\n    </div>\n  </div>\n\n  <!-- Faculty Tasks Column -->\n  <div class="col-md-6">\n    <div class="card shadow-sm mb-4 h-100">\n      <div class="card-header">\n        <strong>Faculty Review</strong>\n      </div>\n      <div class="card-body">\n        {% if faculty_tasks %}\n          {% for disease_name, tasks in faculty_tasks.items() %}\n            {% if tasks %}\n            <div class="card mb-3">\n              <div class="card-header d-flex justify-content-between align-items-center">\n                <strong>{{ disease_name }}</strong>\n                <span class="badge bg-primary">{{ faculty_totals[disease_name] }} pending</span>\n              </div>\n              <div class="card-body p-2">\n                <div class="list-group list-group-flush">\n                  {% for task in tasks %}\n                    <a href="{{ url_for('grading.dual_grading_task', task_id=task.id) }}" class="list-group-item list-group-item-action">\n                      <div class="d-flex justify-content-between align-items-center">\n                        <span class="me-2">Task #{{ task.id }}</span>\n                        <span class="badge bg-info">{{ task.state }}</span>\n                      </div>\n                      <div class="d-flex align-items-center mt-1">\n                        {% if task.encounter_file %}\n                          <div class="me-2">\n                            <img src="{{ url_for('media._imgForGradingByUUID', uuid_str=task.encounter_file.uuid) }}" alt="Thumbnail" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">\n                          </div>\n                          <div>\n                            <small class="text-muted">\n                              Image: {{ task.encounter_file.uuid }}\n                            </small>\n                            <div>\n                              <small class="text-muted">Hospital: {{ task.lab_unit.name if task.lab_unit else 'Unknown' }}</small>\n                            </div>\n                            <div>\n                              <small class="text-muted">\n                                Capture Date: \n                                {% if task.encounter_file.patient_encounter and task.encounter_file.patient_encounter.capture_date_dt %}\n                                  {{ task.encounter_file.patient_encounter.capture_date_dt.strftime('%Y-%m-%d') }}\n                                {% else %}\n                                  Unknown\n                                {% endif %}\n                              </small>\n                            </div>\n                          </div>\n                        {% elif task.direct_image %}\n                          <div class="me-2">\n                            <img src="{{ url_for('media._imgForGradingByUUID', uuid_str=task.direct_image.uuid) }}" alt="Thumbnail" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">\n                          </div>\n                          <div>\n                            <small class="text-muted">\n                              Image: {{ task.direct_image.uuid }}\n                            </small>\n                            <div>\n                              <small class="text-muted">Hospital: {{ task.direct_image.lab_unit.name if task.direct_image.lab_unit else 'Unknown' }}</small>\n                            </div>\n                            <div>\n                              <small class="text-muted">\n                                Upload Date: \n                                {% if task.direct_image.created_at %}\n                                  {{ task.direct_image.created_at.strftime('%Y-%m-%d') }}\n                                {% else %}\n                                  Unknown\n                                {% endif %}\n                              </small>\n                            </div>\n                          </div>\n                        {% endif %}\n                      </div>\n                    </a>\n                  {% endfor %}\n                </div>\n              </div>\n              {% if faculty_total_pages[disease_name] > 1 %}\n              <div class="card-footer d-flex justify-content-between">\n                <a href="{{ faculty_prev_urls[disease_name] or '#' }}" class="btn btn-sm btn-outline-secondary {% if not faculty_prev_urls[disease_name] %}disabled{% endif %}">Prev</a>\n                <span class="small text-muted">Page {{ request.args.get('faculty_' + disease_name.replace(' ', '_') + '_p', 1) }} of {{ faculty_total_pages[disease_name] }}</span>\n                <a href="{{ faculty_next_urls[disease_name] or '#' }}" class="btn btn-sm btn-outline-secondary {% if not faculty_next_urls[disease_name] %}disabled{% endif %}">Next</a>\n              </div>\n              {% endif %}\n            </div>\n            {% endif %}\n          {% endfor %}\n        {% else %}\n          <p class="text-muted">No faculty review tasks available.</p>\n        {% endif %}\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Arbitration Tasks Below -->\n{% if is_admin and arbitration_tasks %}\n<div class="row">\n  <div class="col-12">\n    <div class="card shadow-sm mb-4">\n      <div class="card-header d-flex justify-content-between align-items-center">\n        <strong>Arbitration Tasks</strong>\n        <span class="badge bg-primary">{{ arbitration_totals['all'] }} pending</span>\n      </div>\n      <div class="card-body">\n        {% if arbitration_tasks['all'] %}\n          <div class="list-group">\n            {% for task in arbitration_tasks['all'] %}\n              <a href="{{ url_for('grading.dual_grading_task', task_id=task.id) }}" class="list-group-item list-group-item-action">\n                <div class="d-flex justify-content-between align-items-center">\n                  <span class="me-2">Task #{{ task.id }}</span>\n                  <span class="badge bg-info">{{ task.state }}</span>\n                </div>\n                <div class="d-flex align-items-center mt-1">\n                  {% if task.encounter_file %}\n                    <div class="me-2">\n                      <img src="{{ url_for('media._imgForGradingByUUID', uuid_str=task.encounter_file.uuid) }}" alt="Thumbnail" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">\n                    </div>\n                    <div>\n                      <small class="text-muted">\n                        Image: {{ task.encounter_file.uuid }}\n                      </small>\n                      <div>\n                        <small class="text-muted">Hospital: {{ task.lab_unit.name if task.lab_unit else 'Unknown' }}</small>\n                      </div>\n                      <div>\n                        <small class="text-muted">\n                          Capture Date: \n                          {% if task.encounter_file.patient_encounter and task.encounter_file.patient_encounter.capture_date_dt %}\n                            {{ task.encounter_file.patient_encounter.capture_date_dt.strftime('%Y-%m-%d') }}\n                          {% else %}\n                            Unknown\n                          {% endif %}\n                        </small>\n                      </div>\n                    </div>\n                  {% elif task.direct_image %}\n                    <div class="me-2">\n                      <img src="{{ url_for('media._imgForGradingByUUID', uuid_str=task.direct_image.uuid) }}" alt="Thumbnail" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">\n                    </div>\n                    <div>\n                      <small class="text-muted">\n                        Image: {{ task.direct_image.uuid }}\n                      </small>\n                      <div>\n                        <small class="text-muted">Hospital: {{ task.direct_image.lab_unit.name if task.direct_image.lab_unit else 'Unknown' }}</small>\n                      </div>\n                      <div>\n                        <small class="text-muted">\n                          Upload Date: \n                          {% if task.direct_image.created_at %}\n                            {{ task.direct_image.created_at.strftime('%Y-%m-%d') }}\n                          {% else %}\n                            Unknown\n                          {% endif %}\n                        </small>\n                      </div>\n                    </div>\n                  {% endif %}\n                </div>\n              </a>\n            {% endfor %}\n          </div>\n        {% else %}\n          <p class="text-muted">No arbitration tasks available.</p>\n        {% endif %}\n      </div>\n      {% if arbitration_total_pages['all'] > 1 %}\n      <div class="card-footer d-flex justify-content-between">\n        <a href="{{ arbitration_prev_url or '#' }}" class="btn btn-sm btn-outline-secondary {% if not arbitration_prev_url %}disabled{% endif %}">Prev</a>\n        <span class="small text-muted">Page {{ arbitration_page }} of {{ arbitration_total_pages['all'] }}</span>\n        <a href="{{ arbitration_next_url or '#' }}" class="btn btn-sm btn-outline-secondary {% if not arbitration_next_url %}disabled{% endif %}">Next</a>\n      </div>\n      {% endif %}\n    </div>\n  </div>\n</div>\n{% endif %}\n\n<!-- History of My Gradings -->\n<div class="card card-aurora shadow-sm">\n  <div class="card-header d-flex justify-content-between align-items-center">\n    <strong>My Gradings</strong>\n    <span class="small text-muted">{{ my_total or 0 }} total</span>\n  </div>\n  <div class="card-body p-0">\n    <div class="p-2 border-bottom">\n      <div class="d-flex align-items-center gap-3 flex-wrap">\n        <div class="d-flex align-items-center gap-2">\n          <span class="small text-muted">Type:</span>\n          {% set gfor_opts = ['all','glaucoma','dr','amd'] %}\n          <div class="btn-group btn-group-sm" role="group">\n            {% for f in gfor_opts %}\n              <a class="btn btn-outline-secondary text-uppercase {% if gfor==f %}active{% endif %}"\n                 href="{{ url_for('grading.index', gfor=f, task_type=task_type, p=1) }}">{{ f }}</a>\n            {% endfor %}\n          </div>\n        </div>\n        <div class="d-flex align-items-center gap-2">\n          <span class="small text-muted">Task Type:</span>\n          {% set task_type_opts = ['all','dual','single'] %}\n          <div class="btn-group btn-group-sm" role="group">\n            {% for t in task_type_opts %}\n              <a class="btn btn-outline-secondary text-uppercase {% if task_type==t %}active{% endif %}"\n                 href="{{ url_for('grading.index', gfor=gfor, task_type=t, p=1) }}">{{ t }}</a>\n            {% endfor %}\n          </div>\n        </div>\n        {% if type_counts %}\n          <span class="ms-auto small text-muted">\n            {% for k,v in type_counts.items() %}\n              <span class="me-2">{{ k }}: <strong>{{ v }}</strong></span>\n            {% endfor %}\n          </span>\n        {% endif %}\n      </div>\n    </div>\n    <table id="gradings-table" class="table table-sm table-striped table-hover align-middle mb-0">\n      <thead>\n        <tr>\n          <th style="width: 180px;">Graded At</th>\n          <th style="width: 340px;">Image UUID</th>\n          <th style="width: 120px;">For</th>\n          <th>Result</th>\n          <th>Remarks</th>\n          <th style="width: 120px;">Action</th>\n        </tr>\n      </thead>\n      <tbody>\n      {% if my_items %}\n        {% for g in my_items %}\n        <tr>\n          <td class="text-nowrap">{{ (g.updated_at or g.created_at).strftime('%Y-%m-%d %H:%M') if g.updated_at or g.created_at else '-' }}</td>\n          <td class="text-break"><code>{% if g.image %}{{ g.image.uuid }}{% elif g.direct_image %}{{ g.direct_image.uuid }}{% else %}&#8212;{% endif %}</code></td>\n          <td class="text-nowrap">{{ badge_for_for(g.graded_for)|safe }}</td>\n          <td>{{ badge_for_impression(g.impression)|safe }}</td>\n          <td class="small text-muted">{{ g.remarks or '' }}</td>\n          <td class="text-end">\n            {% if g.image and g.image.uuid %}\n              <a class="btn btn-sm btn-outline-primary" href="{{ url_for('grading.remedio_glaucoma_image', uuid=g.image.uuid) if g.graded_for == 'glaucoma' else url_for('grading.remedio_dr_image', uuid=g.image.uuid) }}">Revise</a>\n            {% elif g.direct_image and g.direct_image.uuid %}\n              <a class="btn btn-sm btn-outline-primary" href="{{ url_for('grading.direct_image', uuid=g.direct_image.uuid) }}">Revise</a>\n            {% endif %}\n          </td>\n        </tr>\n        {% endfor %}\n      {% else %}\n        <tr><td colspan="6" class="text-center text-muted p-3">No gradings found.</td></tr>\n      {% endif %}\n      </tbody>\n    </table>\n  </div>\n  <div class="card-footer d-flex justify-content-between align-items-center">\n    <div class="small text-muted">Page {{ my_page }} of {{ my_total_pages }}</div>\n    <div class="btn-group btn-group-sm" role="group">\n      <a class="btn btn-outline-secondary {% if not my_prev_url %}disabled{% endif %}" href="{{ my_prev_url or '#' }}">Prev</a>\n      <a class="btn btn-outline-secondary {% if not my_next_url %}disabled{% endif %}" href="{{ my_next_url or '#' }}">Next</a>\n    </div>\n  </div>\n</div>\n\n\n\n{% endblock %}\n{% block page_scripts %}\n<script>\n  document.addEventListener("DOMContentLoaded", function() {\n    // Store current filter values\n    let currentFilters = {\n      gfor: "{{ gfor }}",\n      task_type: "{{ task_type }}",\n      page: {{ my_page }}\n    };\n\n    // Add event listeners for filter buttons\n    const filterButtons = document.querySelectorAll(".btn-group a");\n    filterButtons.forEach(button => {\n      button.addEventListener("click", function(e) {\n        e.preventDefault();\n        const url = new URL(this.href);\n        const gfor = url.searchParams.get("gfor") || "all";\n        const task_type = url.searchParams.get("task_type") || "all";\n        const page = url.searchParams.get("p") || 1;\n        \n        // Update current filters\n        currentFilters.gfor = gfor;\n        currentFilters.task_type = task_type;\n        currentFilters.page = 1; // Reset to first page when changing filters\n        \n        // Update the table with filtered data\n        updateGradingsTable(gfor, task_type, 1);\n      });\n    });\n    \n    // Add event listeners for pagination buttons\n    const paginationButtons = document.querySelectorAll(".card-footer .btn-group-sm a");\n    paginationButtons.forEach(button => {\n      button.addEventListener("click", function(e) {\n        e.preventDefault();\n        if (!this.classList.contains("disabled")) {\n          const url = new URL(this.href);\n          const page = parseInt(url.searchParams.get("p")) || 1;\n          \n          // Update current filters\n          currentFilters.page = page;\n          \n          // Update the table with paginated data\n          updateGradingsTable(currentFilters.gfor, currentFilters.task_type, page);\n        }\n      });\n    });\n    \n    // Function to update gradings table with AJAX\n    function updateGradingsTable(gfor, task_type, page) {\n      // Show loading indicator\n      const tableBody = document.querySelector("#gradings-table tbody");\n      tableBody.innerHTML = "<tr><td colspan=\\"6\\" class=\\"text-center text-muted p-3\\">Loading...</td></tr>";\n      \n      // Make AJAX call to fetch filtered and paginated data\n      fetch(`/api/gradings?gfor=${encodeURIComponent(gfor)}&task_type=${encodeURIComponent(task_type)}&page=${page}`)\n        .then(response => response.json())\n        .then(data => {\n          // Update the table with the new data\n          updateTableContent(data);\n          // Update pagination controls\n          updatePagination(data);\n          // Update total count\n          updateTotalCount(data.total);\n        })\n        .catch(error => {\n          console.error("Error fetching gradings data:", error);\n          tableBody.innerHTML = "<tr><td colspan=\\"6\\" class=\\"text-center text-danger p-3\\">Error loading data. Please try again.</td></tr>";\n        });\n    }\n    \n    // Function to update table content\n    function updateTableContent(data) {\n      const tableBody = document.querySelector("#gradings-table tbody");\n      \n      if (data.gradings && data.gradings.length > 0) {\n        let rowsHtml = "";\n        data.gradings.forEach(g => {\n          rowsHtml += `\n            <tr>\n              <td class="text-nowrap">${g.graded_at}</td>\n              <td class="text-break"><code>${g.image_uuid || "&#8212;"}</code></td>\n              <td class="text-nowrap">${badgeForFor(g.graded_for)}</td>\n              <td>${badgeForImpression(g.impression)}</td>\n              <td class="small text-muted">${g.remarks}</td>\n              <td class="text-end">\n                ${g.revise_url ? `<a class="btn btn-sm btn-outline-primary" href="${g.revise_url}">Revise</a>` : ""}\n              </td>\n            </tr>\n          `;\n        });\n        tableBody.innerHTML = rowsHtml;\n      } else {\n        tableBody.innerHTML = "<tr><td colspan=\\"6\\" class=\\"text-center text-muted p-3\\">No gradings found.</td></tr>";\n      }\n    }\n    \n    // Function to update pagination controls\n    function updatePagination(data) {\n      const paginationContainer = document.querySelector(".card-footer .btn-group-sm");\n      \n      // Update previous button\n      const prevButton = paginationContainer.querySelector("a:first-child");\n      if (data.has_prev) {\n        prevButton.classList.remove("disabled");\n        prevButton.href = `/grading?p=${data.page-1}&gfor=${encodeURIComponent(currentFilters.gfor)}&task_type=${encodeURIComponent(currentFilters.task_type)}`;\n      } else {\n        prevButton.classList.add("disabled");\n        prevButton.href = "#";\n      }\n      \n      // Update next button\n      const nextButton = paginationContainer.querySelector("a:last-child");\n      if (data.has_next) {\n        nextButton.classList.remove("disabled");\n        nextButton.href = `/grading?p=${data.page+1}&gfor=${encodeURIComponent(currentFilters.gfor)}&task_type=${encodeURIComponent(currentFilters.task_type)}`;\n      } else {\n        nextButton.classList.add("disabled");\n        nextButton.href = "#";\n      }\n      \n      // Update page info\n      const pageInfo = document.querySelector(".card-footer .small.text-muted");\n      pageInfo.textContent = `Page ${data.page} of ${data.total_pages}`;\n    }\n    \n    // Function to update total count\n    function updateTotalCount(total) {\n      const totalCount = document.querySelector(".card-header .small.text-muted");\n      totalCount.textContent = `${total} total`;\n    }\n    \n    // Helper functions for badges (simplified versions)\n    function badgeForFor(val) {\n      const v = (val || "").toLowerCase();\n      if (v === "glaucoma") {\n        return "<span class=\\"badge rounded-pill badge-soft-primary\\">Glaucoma</span>";\n      } else if (v === "dr") {\n        return "<span class=\\"badge rounded-pill badge-soft-info\\">DR</span>";\n      } else if (v === "amd") {\n        return "<span class=\\"badge rounded-pill badge-soft-purple\\">AMD</span>";\n      } else {\n        return `<span class=\\"badge rounded-pill badge-soft-secondary\\">${val || "-"}</span>`;\n      }\n    }\n    \n    function badgeForImpression(val) {\n      const t = (val || "").toLowerCase();\n      if (t === "normal") {\n        return "<span class=\\"badge rounded-pill badge-soft-success\\">Normal</span>";\n      } else if (t === "glaucoma suspect" || t === "suspect") {\n        return "<span class=\\"badge rounded-pill badge-soft-warning\\">Glaucoma Suspect</span>";\n      } else if (t === "glaucoma") {\n        return "<span class=\\"badge rounded-pill badge-soft-danger\\">Glaucoma</span>";\n      } else if (t === "other retinal" || t === "other") {\n        return "<span class=\\"badge rounded-pill badge-soft-info\\">Other Retinal</span>";\n      } else if (t === "not gradable" || t === "notgradable" || t === "ungradable") {\n        return "<span class=\\"badge rounded-pill badge-soft-secondary\\">Not gradable</span>";\n      } else {\n        return `<span class=\\"badge rounded-pill badge-soft-secondary\\">${val || "-"}</span>`;\n      }\n    }\n  });\n</script>\n{% endblock %}