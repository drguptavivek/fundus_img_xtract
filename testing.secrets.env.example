# S3 Integration Test Configuration
# Copy this file to testing.secrets.env and fill in your credentials
# The testing.secrets.env file is gitignored and will not be committed

# S3 Provider: aws, r2, hetzner, gcp, azure, minio, other
S3_TEST_PROVIDER="aws"

# S3 Bucket Name (must exist and be accessible with your credentials)
S3_TEST_BUCKET_NAME="your-test-bucket-name"

# S3 Region
S3_TEST_REGION="us-east-1"

# AWS/S3 Access Key ID
S3_TEST_ACCESS_KEY="your-access-key-id"

# AWS/S3 Secret Access Key
S3_TEST_SECRET_KEY="your-secret-access-key"

# Custom Endpoint (optional - required for non-AWS providers)
# Examples:
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#   Hetzner: https://<your-endpoint>.your-objectstorage.com
#   MinIO: http://localhost:9000
S3_TEST_ENDPOINT=""
