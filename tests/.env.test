# Test environment configuration
DATABASE_URL=sqlite:///test_zip_processing.db
TESTING=True

# Override directories for testing
UPLOAD_DIR=tests/files/uploaded
IMAGE_DIR=tests/files/images
PDF_DIR=tests/files/pdfs
PROCESSED_DIR=tests/files/processed
PROCESSING_ERROR_DIR=tests/files/processing_error
DIRECT_UPLOAD_DIR=tests/files/direct_uploads

# Flask settings
FLASK_SECRET_KEY=test-secret-key-for-testing-purposes-only-do-not-use-in-production
ASSETS_VERSION=test-v1.0.0
STATIC_MAX_AGE=0

# Upload limits
MAX_CONTENT_LENGTH=52428800
PER_FILE_MAX_BYTES=10485760
MAX_FILES_PER_UPLOAD=10
DIRECT_UPLOAD_MAX_FILES=5
DIRECT_UPLOAD_MAX_FILE_SIZE_MB=2

# Logging (point to test logs directory)
HTTP_SUCCESS_LOG=tests/logs/http_success.log
HTTP_ERROR_LOG=tests/logs/http_error.log
ZIP_INGEST_LOG=tests/logs/zip_main_process_log.txt
SUCCESS_LOG=tests/logs/process_pdf_success_log.txt
ERROR_LOG=tests/logs/process_pdf_error_log.txt

# UI settings
UPLOADED_RESULTS_PAGE_SIZE=5
SCREENINGS_PAGE_SIZE=10